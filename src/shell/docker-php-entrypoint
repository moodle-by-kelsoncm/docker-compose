#!/usr/bin/env bash

set -e

run_as_www_data() {
    if [ "$(id -u)" = "0" ]; then
        runuser -u www-data -- "$@"
    else
        "$@"
    fi
}

if [ "$1" = "" ] || [ "$1" = "supervisord" ] || [ "$1" = "/usr/bin/supervisord" ] || [ "$1" = "apache2-foreground" ]; then
    echo "Starting Moodle"
    DATAROOT="${CFG_DATAROOT:-/var/www/moodledata}"
    if [ "${CFG_ADMINUSER}" != "" ]; then
        cp /var/www/html/deploy/climaintenance.html "${DATAROOT}/climaintenance.html"
        apache2ctl start &

        run_as_www_data php waitdb.php

        echo "Install Moodle database, if necessary." \
        && run_as_www_data php admin/cli/install_database.php --agree-license --lang=en --adminuser=admin --adminpass=admin --adminemail=admin@server.local --fullname=Moodle --shortname=Moodle --summary=Moodle \
        && echo "Install Moodle: OK"

        echo "Upgrade Moodle database, if necessary" \
        && run_as_www_data php admin/cli/upgrade.php --non-interactive --allow-unstable \
        && echo "Upgrade Moodle: OK"

        echo "Baixa os content types do H5P"
        run_as_www_data php admin/cli/scheduled_task.php -f --execute=\\core\\task\\h5p_get_content_types_task >> /var/log/moodle/cron.log &
        echo "Upgrade Moodle: OK"

        apache2ctl stop
        rm -f "${DATAROOT}/climaintenance.html"
    fi

    if [ "$(id -u)" = "0" ]; then
        chown -R www-data:www-data "$DATAROOT" /var/moodledata /var/www/moodledata /var/log/moodle /var/log/apache2 2>/dev/null || true
    fi
fi

exec "$@"